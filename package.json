{
  "name": "vibe",
  "private": true,
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:server": "npm run dev:server -w server",
    "dev:worker": "npm run dev:worker -w server",
    "dev:all": "concurrently -n server,worker -c blue,magenta \"npm run dev:server\" \"npm run dev:worker\"",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:push": "npm run prisma:push -w server",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "prisma:studio": "npm run prisma:studio -w server",
    "prisma:reset": "npm run prisma:reset -w server"
  },
  "workspaces": [
    "server"
  ],
  "dependencies": {
    "add": "^2.0.9",
    "git": "^0.1.5",
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
